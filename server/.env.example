# ==========================================
# Application Configuration
# ==========================================

# JWT Configuration
# Generate a strong, random 256-bit string for production
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRATION_HOURS=24

# ==========================================
# Database Configuration (PostgreSQL)
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=devuser
DB_PASSWORD=devpassword
DB_NAME=musicstand
# Use "require" or "verify-full" in production environments
DB_SSLMODE=disable